{
    "name": "TravelMapster (Node 22 + PostgreSQL)",
    "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {}
    },
    "forwardPorts": [3000, 5432],
    "postCreateCommand": "npm ci",
    "postStartCommand": "docker compose -f infra/compose/compose.yaml up -d postgres",
    "containerEnv": {
        "DATABASE_URL": "postgres://travelmapster:travelmapster@localhost:5432/travelmapster"
    },
    "customizations": {
        "vscode": {
            "extensions": ["dbaeumer.vscode-eslint"]
        }
    }
}
