{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"],
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.js", "public/js/**/*.js"],
  "exclude": ["public/vendor"]
}
