# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=3000
METRICS_PORT=9464
LOG_LEVEL=info

# PostgreSQL (the PG* variables also work: PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD)
DATABASE_URL=postgres://travelmapster:travelmapster@localhost:5432/travelmapster

# Required in production: at least 32 random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# Proxy addresses to trust for client IPs (true, hop count, or comma-separated CIDRs)
TRUST_PROXY=false
